#!/usr/bin/env bash
set -euo pipefail
# COLA_VERIFIED_DEPLOY_V4
# Install once as root at /usr/local/sbin/deploy-cola. CI supplies its tested SHA.

repo=/opt/stacks/cola
state_dir=/var/lib/colabike

exec 9>/var/lock/colabike-deploy.lock
flock -w 60 9 || { echo "Another deployment still holds the server lock" >&2; exit 1; }

[[ -d "$repo/.git" ]] || { echo "Repository not found: $repo" >&2; exit 1; }
mkdir -p "$state_dir"

sha=${1:-$(cat "$state_dir/verified-sha" 2>/dev/null || true)}
[[ "$sha" =~ ^[a-f0-9]{40}$ ]] || {
  echo "A tested commit SHA is required for the first deployment" >&2
  exit 1
}

prebuilt=false
if [[ $# == 4 && "$2" == prebuilt && "$3" =~ ^[1-9][0-9]*$ && "$4" =~ ^[1-9][0-9]*$ ]]; then
  prebuilt=true
elif [[ $# -gt 1 ]]; then
  echo "Expected SHA [prebuilt RUN_ID ATTEMPT]" >&2
  exit 64
fi

repo_owner=$(stat -c '%U' "$repo")
[[ "$repo_owner" =~ ^[a-z_][a-z0-9_-]*$ ]] || {
  echo "Unsafe repository owner: $repo_owner" >&2
  exit 1
}

git_as_owner() {
  runuser -u "$repo_owner" -- git -C "$repo" "$@"
}

cleanup_prebuilt_images() {
  local tag removed=0
  # CI archive tags are transport names only. Production containers use the
  # Compose aliases created by deploy-cola-images.py, so these SHA tags can be
  # removed after a successful deployment. Keep cleanup scoped to ColaBike:
  # no global image/cache/volume prune belongs in the production wrapper.
  while IFS= read -r tag; do
    [[ "$tag" =~ ^cola-ci-(app|ops|resolver):[a-f0-9]{40}$ ]] || continue
    if docker image rm "$tag" >/dev/null 2>&1; then
      ((removed += 1))
    else
      echo "Warning: could not remove transient CI image tag $tag" >&2
    fi
  done < <(docker image ls --format '{{.Repository}}:{{.Tag}}' 2>/dev/null || true)
  echo "Removed $removed transient CI image tag(s)"
}

git_as_owner fetch --prune origin main
remote_main=$(git_as_owner rev-parse refs/remotes/origin/main)

if [[ "$sha" != "$remote_main" ]]; then
  echo "Refusing stale or non-main deployment: requested=$sha main=$remote_main" >&2
  exit 1
fi

git_as_owner cat-file -e "$sha^{commit}"
git_as_owner diff --quiet
git_as_owner diff --cached --quiet
git_as_owner checkout -B main "$sha"

cd "$repo"
compose=(docker compose)

if [[ -f .env.production ]]; then
  [[ -f compose.prod.yaml ]] || {
    echo "compose.prod.yaml is required when .env.production exists" >&2
    exit 1
  }
  compose+=(--env-file .env.production -f compose.prod.yaml)
fi

"${compose[@]}" config --quiet
if "$prebuilt"; then
  # Fail closed: invalid/missing CI images must never fall back to a VPS build.
  timeout --kill-after=30s 14m python3 /usr/local/sbin/deploy-cola-images.py "$sha" "$3" "$4" -- "${compose[@]}"
  timeout --kill-after=30s 5m "${compose[@]}" up --no-build -d --wait --wait-timeout 180
else
  # Legacy bootstrap/operator path, kept for existing installed workflows.
  timeout --kill-after=30s 35m "${compose[@]}" up --build -d --wait --wait-timeout 180
fi
"${compose[@]}" ps

printf '%s\n' "$sha" > "$state_dir/verified-sha"
if "$prebuilt"; then
  cleanup_prebuilt_images
fi
echo "Deployed tested commit $sha"
