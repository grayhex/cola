#!/usr/bin/env bash
set -euo pipefail
# COLA_STAGING_DEPLOY_V2
# Install as root at /usr/local/sbin/deploy-cola-staging.
# The workflow supplies a SHA that passed CI.
#
# Security boundary:
# - source code may come from the selected staging ref;
# - Docker Compose topology always comes from trusted origin/main.

repo=/opt/stacks/cola
state_dir=/var/lib/colabike
trusted_compose="$repo/.compose.staging.trusted.yaml"

exec 9>/var/lock/colabike-deploy.lock
flock 9

[[ -d "$repo/.git" ]] || { echo "Repository not found: $repo" >&2; exit 1; }
mkdir -p "$state_dir"

sha=${1:-}
[[ "$sha" =~ ^[a-f0-9]{40}$ ]] || {
  echo "A verified 40-character commit SHA is required" >&2
  exit 1
}

repo_owner=$(stat -c '%U' "$repo")
[[ "$repo_owner" =~ ^[a-z_][a-z0-9_-]*$ ]] || {
  echo "Unsafe repository owner: $repo_owner" >&2
  exit 1
}

git_as_owner() {
  runuser -u "$repo_owner" -- git -C "$repo" "$@"
}

git_as_owner diff --quiet
git_as_owner diff --cached --quiet

# Refresh trusted deployment topology from main.
git_as_owner fetch --prune origin main
main_sha=$(git_as_owner rev-parse refs/remotes/origin/main)

# Fetch the exact SHA that CI verified. This does not depend on the feature branch
# still pointing at the same commit by the time deployment starts.
if ! git_as_owner fetch --no-tags origin "$sha"; then
  echo "Unable to fetch verified commit $sha from origin" >&2
  exit 1
fi
git_as_owner cat-file -e "$sha^{commit}"

# Materialize only the trusted main version of compose.yaml.
tmp_compose=$(mktemp "$repo/.compose.staging.XXXXXX.yaml")
trap 'rm -f "$tmp_compose"' EXIT
git_as_owner show "$main_sha:compose.yaml" > "$tmp_compose"
chown root:root "$tmp_compose"
chmod 600 "$tmp_compose"

git_as_owner checkout -B staging-deploy "$sha"

cd "$repo"
docker compose -f "$tmp_compose" config --quiet
docker compose -f "$tmp_compose" up --build -d --wait --wait-timeout 180
docker compose -f "$tmp_compose" ps

printf '%s\n' "$sha" > "$state_dir/staging-sha"
printf '%s\n' "$main_sha" > "$state_dir/staging-compose-main-sha"
echo "Staging deployed verified commit $sha using compose.yaml from main $main_sha"
