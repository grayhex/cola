#!/usr/bin/env bash
# Forced command for the GitHub Actions deploy key (user "deploy").
# Install: /usr/local/sbin/deploy-cola-ssh, owner root, mode 0755.
# authorized_keys:
#   restrict,command="/usr/local/sbin/deploy-cola-ssh" ssh-ed25519 AAAA... gha-deploy
# sudoers (/etc/sudoers.d/cola-deploy, visudo -cf):
#   deploy ALL=(root) NOPASSWD: /usr/local/sbin/deploy-cola
set -euo pipefail

request="${SSH_ORIGINAL_COMMAND:-}"

if [[ "$request" =~ ^([0-9a-f]{40})\ prebuilt\ ([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
  args=("${BASH_REMATCH[1]}" prebuilt "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
elif [[ "$request" =~ ^[0-9a-f]{40}$ ]]; then
  args=("$request")
else
  logger -t deploy-cola-ssh "rejected malformed deployment request"
  echo "expected SHA [prebuilt RUN_ID ATTEMPT]" >&2
  exit 64
fi

logger -t deploy-cola-ssh "deploy requested: ${args[*]}"
exec sudo -n /usr/local/sbin/deploy-cola "${args[@]}"
