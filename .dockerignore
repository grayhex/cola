# Explicit app build inputs. Resolver has its own context and ignore file.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.mjs
!tsconfig.json
!proxy.ts
!app/
!app/**
!lib/
!lib/**
# Include only the shared source files, not the service's tests and fixtures.
!services/bike-resolver/src/component-identity.ts
!services/bike-resolver/src/domain.ts
!services/bike-resolver/src/context.ts
!services/bike-resolver/src/settings.ts
!services/bike-resolver/src/planner.ts
!db/
!db/*.sql
!public/
!public/**
# Exact file exceptions avoid including test harnesses and host-side tools.
!scripts/build-version.js
!scripts/copy-maplibre-worker.js
!scripts/copy-rive-runtime.js
!scripts/check-runtime.js
!scripts/migrate.js
!scripts/bootstrap-admin.js
!scripts/reset-password.js
!scripts/set-admin.js
!scripts/audit-photo-files.js
!scripts/recalculate-photo-storage.js
!scripts/rebuild-factory-components.js
!scripts/cleanup-rides.js
!scripts/chat-sync.js
!scripts/chat-setup.js
!scripts/activity-sync.js
!scripts/notification-email.js
!scripts/notification-push.js
!scripts/bike-week.js
!scripts/component-catalog-seed.ts
!scripts/component-catalog-import.ts
!data/component-catalog/**
# Generated assets are rebuilt from the installed, locked package.
public/maplibre/
public/rive/runtime/
public/test-map-style.json
**/node_modules/
**/.next/
**/.cache/
**/coverage/
**/test-results/
**/e2e-evidence/
**/playwright-report/
**/*.log
**/*.tsbuildinfo
**/.DS_Store
