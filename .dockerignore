# Explicit app build inputs. Resolver has its own context and ignore file.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.mjs
!app/
!app/**
!lib/
!lib/**
!db/
!db/*.sql
!public/
!public/**
!scripts/
!scripts/build-version.js
!scripts/copy-maplibre-worker.js
!scripts/check-runtime.js
!scripts/migrate.js
!scripts/bootstrap-admin.js
!scripts/set-admin.js
!scripts/audit-photo-files.js
!scripts/recalculate-photo-storage.js
!scripts/cleanup-rides.js
# Generated assets are rebuilt from the installed, locked package.
public/maplibre/
public/test-map-style.json
**/node_modules/
**/.next/
**/.cache/
**/coverage/
**/test-results/
**/playwright-report/
**/*.log
**/*.tsbuildinfo
**/.DS_Store
