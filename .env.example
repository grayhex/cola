POSTGRES_PASSWORD=colabike-local-only
DATABASE_URL=postgresql://colabike:colabike-local-only@localhost:5432/colabike
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
UPLOAD_DIR=./uploads

# Optional for local Next.js development; Compose sets internal DNS automatically.
BIKE_RESOLVER_URL=http://localhost:8080

# Optional Stream Chat. Read docs/integrations/chat.md before enabling (dedicated EU West app).
STREAM_CHAT_ENABLED=false
STREAM_CHAT_API_KEY=
STREAM_CHAT_API_SECRET=

# Optional place search for choosing a ride's area (docs/modules/rides.md). Default:
# OpenStreetMap Nominatim. GEOCODER=off turns it off, GEOCODER=yandex needs the key
# of the Yandex Geocoder HTTP API; GEOCODER_URL points to another Nominatim-compatible server.
GEOCODER=
GEOCODER_URL=
YANDEX_GEOCODER_KEY=

# Ride with GPS: create an OAuth client; see docs/integrations/activity-sync.md.
RWGPS_ENABLED=false
RWGPS_API_KEY=
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=
# 32 random bytes as 64 hexadecimal characters; preserve separately from DB backups.
ACTIVITY_TOKEN_KEY=

# Optional sign-in with Yandex ID; see docs/modules/accounts.md before enabling.
YANDEX_ID_ENABLED=false
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
# HTTPS-ссылка приложения (Universal Link / App Link) для нативного входа через
# провайдера; пусто — нативный вход выключен.
NATIVE_AUTH_RETURN_URL=
# Android App Link: SHA-256 сертификата подписи приложения (AA:BB:… или 64 hex),
# несколько — через запятую (например, release и debug). Публикуется в
# /.well-known/assetlinks.json; без отпечатка список пуст и ссылка не подтверждена.
# ANDROID_APP_ID нужен, только если applicationId отличается от ru.colabike.app.
ANDROID_CERT_SHA256=
ANDROID_APP_ID=

# Sessions of native clients (API v1): access token lifetime in minutes, refresh
# token idle and absolute limits in days. These are the defaults.
DEVICE_ACCESS_TOKEN_MINUTES=15
DEVICE_REFRESH_IDLE_DAYS=60
DEVICE_REFRESH_ABSOLUTE_DAYS=180
