    {
      "name": "push_not_connected",
      "description": "Push нельзя включить, пока доставка не подключена: 503. Выключить можно всегда.",
      "request": {
        "method": "PATCH",
        "path": "/me/notification-settings",
        "body": {
          "channels": {
            "push": {
              "enabled": true
            }
          }
        }
      },
      "response": {
        "status": 503,
        "body": {
          "error": {
            "code": "service_unavailable",
            "message": "Push-уведомления пока не подключены"
          }
        }
