      "request": {
        "method": "PATCH",
        "path": "/me/notification-settings",
        "body": {
          "categories": [
            {
              "key": "market",
              "push": true
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "code": "invalid_request",
            "message": "Проверьте поля запроса.",
            "details": [
              {
                "path": "categories.0.push",
                "message": "Этот канал не передаёт такую категорию"
              }
            ]
          }
        }
      }
