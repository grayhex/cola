    {
      "name": "stale_version",
      "description": "Изменение с `If-Match` применяется только к версии, которую клиент видел; иначе 412, клиент читает настройки снова.",
      "request": {
        "method": "PATCH",
        "path": "/me/notification-settings",
        "headers": {
          "If-Match": "\"example-etag-0\""
        },
        "body": {
          "reminders": false
        }
      },
      "response": {
        "status": 412,
        "body": {
          "error": {
            "code": "precondition_failed",
            "message": "Объект изменился после того, как вы его прочитали. Прочитайте его снова."
          }
        }
      }
    },
