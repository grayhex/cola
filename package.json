{
  "name": "colabike",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-rive-runtime.js && node scripts/copy-maplibre-worker.js && next dev --hostname 0.0.0.0",
    "build": "node scripts/copy-rive-runtime.js && node scripts/copy-maplibre-worker.js && node scripts/build-version.js && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.strict.json",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "test:integration": "node scripts/test-resolver-integration.js",
    "test:e2e": "node scripts/test-resolver-integration.js --e2e",
    "rive:export": "node scripts/export-rive.js",
    "test:typecheck": "node scripts/test-typecheck.js"
  },
  "dependencies": {
    "@rive-app/react-canvas-lite": "4.35.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "marked": "17.0.6",
    "motion": "13.4.4",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "stream-chat": "9.53.0",
    "stream-chat-react": "14.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "1.0.9",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "^1.63.0",
    "@rive-app/canvas-advanced-lite": "2.43.1",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
