{
  "name": "colabike",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-rive-runtime.js && node scripts/copy-maplibre-worker.js && next dev --hostname 0.0.0.0",
    "build": "node scripts/copy-rive-runtime.js && node scripts/copy-maplibre-worker.js && node scripts/build-version.js && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0 && eslint --config eslint.resolver.config.js services/bike-resolver/src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/check-production-typescript.js && tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node --test tests/*.test.js tests/*.test.ts",
    "db:migrate": "node scripts/migrate.js",
    "test:integration": "node scripts/test-resolver-integration.js",
    "test:e2e": "node scripts/test-resolver-integration.js --e2e",
    "rive:export": "node scripts/export-rive.js",
    "test:typecheck": "node scripts/test-typecheck.js",
    "check:production-ts": "node scripts/check-production-typescript.js"
  },
  "dependencies": {
    "@rive-app/react-canvas-lite": "4.38.0",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/markdown": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.64.0",
    "maplibre-gl": "^6.16.0",
    "marked": "17.0.6",
    "motion": "13.5.1",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "stream-chat": "9.54.3",
    "stream-chat-react": "14.14.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "1.0.13",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@rive-app/canvas-advanced-lite": "2.49.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
