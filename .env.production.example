# Copy to .env.production, chmod 600. Fill all secrets before starting.
APP_ORIGIN=https://colabike.ru
COOKIE_SECURE=true
POSTGRES_PASSWORD=
TRUSTED_PROXY_KEY=
BIKE_RESOLVER_TOKEN=
# Password recovery and address confirmation. Without SMTP they are unavailable.
# smtps://user:password@smtp.example.com:465 or smtp://…:587 (STARTTLS required).
SMTP_URL=
MAIL_FROM="ColaBike <noreply@colabike.ru>"
# Optional native push through RuStore (docs/modules/notifications.md, «Push»).
# PUSH_TOKEN_KEY seals the device addresses in the database: openssl rand -base64 32.
# Keep the previous key in PUSH_TOKEN_KEY_PREVIOUS while rotating. Project ids are those of
# the RuStore push projects the app may register with; the service token sends. All empty = off.
PUSH_TOKEN_KEY=
PUSH_TOKEN_KEY_PREVIOUS=
RUSTORE_PUSH_PROJECTS=
RUSTORE_PUSH_SERVICE_TOKEN=
# Optional: Sentry-compatible DSN (Sentry or self-hosted GlitchTip), HTTPS only.
ERROR_TRACKER_DSN=
# Optional: warn about API requests slower than N ms (default 1000, 0 disables).
SLOW_REQUEST_MS=
# Generate URL-safe secrets: openssl rand -hex 32
# Start: docker compose --env-file .env.production -f compose.prod.yaml up --build -d --wait

# CSP rollout: report-only (default), enforce (after acceptance), off (baseline only).
CSP_MODE=report-only
# Space-separated exact HTTPS origins for custom map styles/tiles/glyphs/sprites.
CSP_MAP_ORIGINS=

# Optional Stream Chat. Read docs/integrations/chat.md before enabling (dedicated EU West app).
STREAM_CHAT_ENABLED=false
STREAM_CHAT_API_KEY=
STREAM_CHAT_API_SECRET=

# Optional activity sync. See docs/integrations/activity-sync.md
RWGPS_ENABLED=false
RWGPS_API_KEY=
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=
ACTIVITY_TOKEN_KEY=

# Optional sign-in with Yandex ID; see docs/modules/accounts.md before enabling.
YANDEX_ID_ENABLED=false
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
# HTTPS-ссылка приложения (Universal Link / App Link) для нативного входа через
# провайдера; пусто — нативный вход выключен. Production-путь Android-клиента:
# https://colabike.ru/app/auth (работает как подтверждённая ссылка только вместе
# с ANDROID_CERT_SHA256 ниже).
NATIVE_AUTH_RETURN_URL=https://colabike.ru/app/auth
# Android App Link: SHA-256 сертификата подписи приложения (AA:BB:… или 64 hex),
# несколько — через запятую (например, release и debug). Публикуется в
# /.well-known/assetlinks.json; без отпечатка список пуст и ссылка не подтверждена.
# ANDROID_APP_ID нужен, только если applicationId отличается от ru.colabike.app.
ANDROID_CERT_SHA256=
ANDROID_APP_ID=

# Sessions of native clients (API v1): access token lifetime in minutes, refresh
# token idle and absolute limits in days. These are the defaults.
DEVICE_ACCESS_TOKEN_MINUTES=15
DEVICE_REFRESH_IDLE_DAYS=60
DEVICE_REFRESH_ABSOLUTE_DAYS=180
