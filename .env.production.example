# Copy to .env.production, chmod 600. Fill all secrets before starting.
APP_ORIGIN=https://colabike.ru
COOKIE_SECURE=true
POSTGRES_PASSWORD=
TRUSTED_PROXY_KEY=
BIKE_RESOLVER_TOKEN=
# Optional: Sentry-compatible DSN (Sentry or self-hosted GlitchTip), HTTPS only.
ERROR_TRACKER_DSN=
# Optional: warn about API requests slower than N ms (default 1000, 0 disables).
SLOW_REQUEST_MS=
# Generate URL-safe secrets: openssl rand -hex 32
# Start: docker compose --env-file .env.production -f compose.prod.yaml up --build -d --wait
